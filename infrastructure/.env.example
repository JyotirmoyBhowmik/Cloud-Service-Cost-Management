# CloudScope Multi-Cloud Platform Configuration
# Copy to .env for local overrides

# Application
PROJECT_NAME="CloudScope Multi-Cloud Governance"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Security & Master Keys
SECRET_KEY="cloudscope-insecure-dev-secret-key-32-bytes-long!!"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite default:
DATABASE_URL="sqlite:///./cloudscope.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+psycopg2://cloudscope:cloudscope_secure_pass_2026!@localhost:5432/cloudscope_db"

# Redis Cache & Background Tasks
REDIS_URL="redis://localhost:6379/0"

# Multi-Cloud Demo Mode (True seeds realistic Azure, AWS, GCP, and OCI estates)
DEMO_MODE_ENABLED=true

# Optional Real Cloud Credentials (Leave empty to use Demo Mode)
# Microsoft Azure
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SUBSCRIPTION_ID=""

# Amazon Web Services
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"

# Google Cloud Platform
GCP_PROJECT_ID=""
GCP_SERVICE_ACCOUNT_KEY_PATH=""

# Oracle Cloud Infrastructure
OCI_TENANCY_OCID=""
OCI_USER_OCID=""
OCI_FINGERPRINT=""
OCI_KEY_FILE_PATH=""
